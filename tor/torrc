# fs0ciety Tor Hidden Service Configuration
# Keys and .onion address: /var/lib/tor/hidden_service/frontend/ (tor_data volume, kept from the
# previous goldy/tor-hidden-service image, so the .onion address does not change).

DataDirectory /var/lib/tor/data

# Hidden service mapping: onion port 80 → frontend container port 3000
HiddenServiceDir /var/lib/tor/hidden_service/frontend/
HiddenServicePort 80 frontend:3000

# Logging
Log notice stdout

# SOCKSPort disabled — we are only running a hidden service, not a relay
SocksPort 0
