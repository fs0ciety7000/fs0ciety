# ╔══════════════════════════════════════════════════════════════╗
# ║  fs0ciety — Environment Configuration                     ║
# ║                                                            ║
# ║  Copy this file to .env and fill in your values:           ║
# ║    cp .env.example .env                                    ║
# ║                                                            ║
# ║  Generate secrets:                                         ║
# ║    openssl rand -hex 32   (for JWT_SECRET)                 ║
# ║    openssl rand -hex 16   (for SURREAL_PASS)               ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Required ──────────────────────────────────────────────────
# Domain name (used for subdomain routing and TLS)
DOMAIN=fs0ciety.local

# JWT signing secret (64-char hex, CHANGE THIS)
JWT_SECRET=replace-with-64-char-hex-secret

# ── Backend ───────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
RUST_LOG=info,fs0ciety_backend=debug

# ── SurrealDB ────────────────────────────────────────────────
# Docker Compose: ws://surrealdb:8000
# Local dev:      ws://127.0.0.1:8000
SURREAL_URL=ws://surrealdb:8000
SURREAL_NS=fs0ciety
SURREAL_DB=main
SURREAL_USER=root
SURREAL_PASS=changeme

# ── Frontend ──────────────────────────────────────────────────
# Dev only (Docker uses INTERNAL_API_URL instead)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws

# ── Auth ──────────────────────────────────────────────────────
# Admin API key for CI/CD post publishing and admin endpoints
ADMIN_API_KEY=

# Public URL for email links (password reset, etc.)
PUBLIC_URL=https://fs0ciety.local

# Resend.com API key for transactional emails (optional)
RESEND_API_KEY=

# ── Seedbox Services (all optional) ──────────────────────────
# Leave blank to disable — the dashboard shows "offline" gracefully.

# Plex
PLEX_URL=http://plex:32400
PLEX_TOKEN=your_plex_token
PLEX_EXTERNAL_URL=https://app.plex.tv/desktop

# Sonarr
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=your_sonarr_key
SONARR_EXTERNAL_URL=

# Radarr
RADARR_URL=http://radarr:7878
RADARR_API_KEY=your_radarr_key
RADARR_EXTERNAL_URL=

# qBittorrent
QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin
QBITTORRENT_EXTERNAL_URL=

# ── Startpage Services (dash.fs0ciety.org) ───────────────────
# Server-side only — not exposed to browser.

# Jellyfin
JELLYFIN_URL=https://jellyfin.cinenode.org
JELLYFIN_API_KEY=

# AdGuard Home (Tailscale IP or local)
ADGUARD_URL=http://100.74.40.4:3000
ADGUARD_USER=
ADGUARD_PASS=

# Jellyseerr / Overseerr
SEERR_URL=https://requests.cinenode.org
SEERR_API_KEY=

# qBittorrent (startpage)
QBIT_URL=https://qbittorrent.cinenode.org
QBIT_USER=
QBIT_PASS=

# SABnzbd (startpage)
SAB_URL=https://sabnzbd.cinenode.org
SAB_API_KEY=

# ── Deployment ────────────────────────────────────────────────
# Email for Let's Encrypt TLS certificates (Traefik)
ACME_EMAIL=admin@fs0ciety.local
