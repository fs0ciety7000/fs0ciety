# ── fs0ciety Backend — Local Development ─────────────────────
# This file is for running the backend outside Docker (just dev-backend).
# In Docker, environment variables come from docker-compose.yml.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
RUST_LOG=info,fs0ciety_backend=debug

# SurrealDB (local dev — docker-compose.dev.yml exposes port 8000)
SURREAL_URL=ws://127.0.0.1:8000
SURREAL_NS=fs0ciety
SURREAL_DB=main
SURREAL_USER=root
SURREAL_PASS=changeme

# Auth
JWT_SECRET=replace-with-64-char-hex-secret

# Seedbox services (optional — leave defaults to test without)
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_key
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_key
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin
